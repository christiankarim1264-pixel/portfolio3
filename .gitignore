# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AI coding tool files
/.agents/
/.claude/
/skills-lock.json
/AGENTS.md
/CLAUDE.md
/CHESS_BOT_HANDOFF.md
/CHESS_BOT_CHEATSHEET.md

# more AI tools (in case you use them later)
/CLAUDE.local.md
/.mcp.json
/GEMINI.md
/.gemini/
/.codex/
/.cursor/
/.cursorrules
/.cursorignore
/.windsurf/
/.windsurfrules
/.clinerules
/.roo/
/.continue/
/.aider*
/.kiro/
/.github/copilot-instructions.md

# Windows and editor junk files
Thumbs.db
desktop.ini
*.log
.eslintcache
/.vscode/
/.idea/

# Spline upload images (not used by the site)
/spline-assets/
